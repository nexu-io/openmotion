# OpenMotion local Docker Compose configuration (AUTH_MODE=dev, MODEL_GATEWAY_MODE=mock).
# Copy to deploy/.env before customizing: `cp deploy/.env.example deploy/.env`
# NEVER commit deploy/.env or real credentials to Git.

# -----------------------------------------------------------------------------
# Local container image tags & host loopback ports
# -----------------------------------------------------------------------------
OPENMOTION_API_IMAGE=openmotion-api:local
OPENMOTION_WORKER_MEDIA_IMAGE=openmotion-worker-media:local
OPENMOTION_WORKER_RENDER_IMAGE=openmotion-worker-render:local
OPENMOTION_CATALOG_SYNC_IMAGE=openmotion-catalog-sync:local

OPENMOTION_PORT=4173
PORT=4173
POSTGRES_PORT=5432
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Core service settings (must match src/infra/config.ts)
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_PUBLIC_ORIGIN=http://127.0.0.1:4173
# Optional cookie-less preview origin (e.g. https://preview.openmotion.example.com).
# Leave empty for single-host local Docker Compose development.
PREVIEW_PUBLIC_ORIGIN=
PREVIEW_TOKEN_TTL_SEC=900
LOG_LEVEL=info
PG_POOL_MAX=20
WORKER_PG_POOL_MAX=10
REDIS_MAXMEMORY=512mb
REDIS_CACHE_URL=
REDIS_CACHE_TTL_SEC=3600

# -----------------------------------------------------------------------------
# Local PostgreSQL & RustFS S3-compatible object storage (synthetic dev defaults)
# -----------------------------------------------------------------------------
POSTGRES_DB=openmotion
POSTGRES_USER=openmotion
POSTGRES_PASSWORD=openmotion_local_dev

S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=openmotion
S3_ACCESS_KEY_ID=openmotion
S3_SECRET_ACCESS_KEY=openmotion_local_dev
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_PUT_TTL_SEC=900
S3_PRESIGN_GET_TTL_SEC=300
S3_PRESIGN_CACHE_WINDOW_SEC=3600
S3_CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Auth & Remote MCP (local dev bypass; production MUST use AUTH_MODE=oidc)
# -----------------------------------------------------------------------------
AUTH_MODE=dev
ALLOW_INSECURE_DEV_AUTH=false
DEV_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
DEV_USER_ID=00000000-0000-4000-8000-000000000002
DEV_PAT=om_pat_devlocal_000000000000000000000000
TRUST_PROXY_HOPS=1

# Required only when AUTH_MODE=oidc (replace with real values outside Git).
# For OpenDesign / Vela Better Auth OIDC, set:
#   OIDC_ISSUER=https://amr-api.open-design.ai/api/auth
#   OIDC_CLIENT_SECRET=<first-party secret> (used for client_secret_post and HS256 ID tokens when disableJwtPlugin=true)
#   MCP_OAUTH_MODE=proxy (recommended when upstream IdP disables DCR/refresh tokens)
# SESSION_SECRET=CHANGE_ME_SESSION_SECRET_MIN_32_CHARS
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=CHANGE_ME_OIDC_CLIENT_ID
# OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
# OIDC_CALLBACK_URL=http://127.0.0.1:4173/auth/callback
SESSION_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=
OIDC_SCOPES=openid profile email
OIDC_CLAIM_SUB=sub
OIDC_CLAIM_EMAIL=email
OIDC_CLAIM_NAME=name
OIDC_CLAIM_WORKSPACE=

MCP_OAUTH_MODE=proxy
MCP_OAUTH_ISSUER=
# Maximum MCP JSON-RPC request body size in bytes (10 MiB)
MCP_MAX_BODY_BYTES=10485760

# -----------------------------------------------------------------------------
# Unified OpenDesign Model Gateway (defaults to local mock fixtures)
# Set MODEL_GATEWAY_MODE=opendesign and supply OPENDESIGN_S2S_API_KEY to use live models.
# -----------------------------------------------------------------------------
MODEL_GATEWAY_MODE=mock
OPENDESIGN_API_URL=https://amr-api.open-design.ai
OPENDESIGN_LINK_URL=https://amr-link.open-design.ai
# OPENDESIGN_S2S_API_KEY=CHANGE_ME_OPENDESIGN_S2S_API_KEY
OPENDESIGN_S2S_API_KEY=
OPENDESIGN_ASR_URL=
OPENDESIGN_BILLING_SYNC_ENABLED=false
ALLOW_DOH_FAKEIP_FALLBACK=false

# -----------------------------------------------------------------------------
# Worker tuning & local container resource limits
# On hosts with >= 8 GiB Docker/Colima VM RAM, raise RENDER_SHM_SIZE=1g and
# RENDER_MEM_LIMIT=4g for long or 1080p/4K exports.
# -----------------------------------------------------------------------------
MEDIA_CONCURRENCY=20
RENDER_CONCURRENCY=1
BLOB_GC_GRACE_SECONDS=604800
HISTORY_COALESCE_WINDOW_MS=4000

API_MEM_LIMIT=1g
MEDIA_MEM_LIMIT=1g
MEDIA_TMP_SIZE=1g
RENDER_MEM_LIMIT=2g
RENDER_SHM_SIZE=512m
RENDER_TMP_SIZE=2g
