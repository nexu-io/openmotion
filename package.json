{
  "name": "openmotion",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run build:studio && node --env-file=.env.development --experimental-strip-types src/entrypoints/api.ts",
    "studio:dev": "vite --config studio/vite.dev.config.ts",
    "start": "node --experimental-strip-types src/entrypoints/api.ts",
    "worker:media": "WORKER_ROLE=media node --experimental-strip-types src/entrypoints/worker.ts",
    "worker:render": "WORKER_ROLE=render node --experimental-strip-types src/entrypoints/worker.ts",
    "catalog:sync": "node --experimental-strip-types scripts/sync-catalog-cas.ts",
    "test": "node --experimental-strip-types --test tests/cloud/*.test.ts",
    "test:cloud": "node --experimental-strip-types --test tests/cloud/*.test.ts",
    "check": "node --experimental-strip-types scripts/check.ts",
    "build:studio": "npm run build:inline && npm run build:template-cards && vite build --config studio/vite.config.ts && node scripts/build-template-guide.mjs",
    "build:tracking": "tsc -p tracking/tsconfig.json",
    "build:observability": "tsc -p packages/observability/tsconfig.json",
    "typecheck:studio": "tsc -p studio/tsconfig.json",
    "design:tokens": "node --experimental-strip-types scripts/design-tokens.ts",
    "design:check": "node --experimental-strip-types scripts/design-check.ts",
    "pretest": "npm run build:studio",
    "test:studio": "vitest run --config studio/vitest.config.ts",
    "verify:export": "node --experimental-strip-types scripts/verify-export.ts",
    "catalog:import": "node --experimental-strip-types scripts/import-hyperframes.ts",
    "catalog:covers": "node --experimental-strip-types scripts/cache-template-covers.ts",
    "catalog:metadata": "node --experimental-strip-types scripts/sync-template-metadata.ts",
    "export:adapters": "node --experimental-strip-types scripts/export-adapters.ts",
    "storage:check": "node --experimental-strip-types scripts/check-repository-storage.ts",
    "templates:check": "node --experimental-strip-types scripts/check-template-library.ts",
    "templates:export": "node --experimental-strip-types scripts/template-library.ts export",
    "templates:manifest": "node --experimental-strip-types scripts/template-library.ts manifest",
    "media:prepare": "node --experimental-strip-types scripts/prepare-pr-media.ts",
    "media:pull": "node --experimental-strip-types scripts/repository-media.ts",
    "components:dev": "vite --config packages/open-design-ui/vite.config.ts --host 127.0.0.1",
    "components:build": "vite build --config packages/open-design-ui/vite.config.ts",
    "build:open-design-ui": "node scripts/build-open-design-ui.mjs",
    "design:dev": "node packages/design-system/workbench/server.js",
    "design:test": "node --test packages/design-system/workbench/*.test.js",
    "build:inline": "node scripts/build-inline-ui.mjs",
    "typecheck:backend": "tsc -p tsconfig.backend.json",
    "typecheck:cloud": "tsc -p tsconfig.cloud.json",
    "typecheck:template-cards": "tsc -p mcp-ui/tsconfig.json",
    "build:template-cards": "npm run typecheck:template-cards && node --experimental-strip-types scripts/build-template-cards.mjs",
    "design:metrics": "node scripts/ui-metrics.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "s3:init": "node --experimental-strip-types scripts/init-s3.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/s3-request-presigner": "^3.782.0",
    "@hono/node-server": "2.1.6",
    "@hyperframes/core": "0.9.7",
    "@hyperframes/lint": "0.9.7",
    "@hyperframes/parsers": "0.9.7",
    "@hyperframes/player": "0.9.7",
    "@hyperframes/sdk": "0.9.7",
    "@hyperframes/shader-transitions": "0.9.7",
    "@hyperframes/studio-server": "0.9.7",
    "@modelcontextprotocol/server": "2.4.0",
    "@zumer/snapdom": "^3.8.1",
    "acorn": "8.19.0",
    "bullmq": "^5.48.0",
    "drizzle-orm": "^0.41.0",
    "fontkit": "2.0.4",
    "gsap": "3.15.0",
    "hono": "4.13.16",
    "hyperframes": "0.9.7",
    "ioredis": "^5.6.1",
    "jose": "6.2.17",
    "pg": "^8.14.1",
    "pptxgenjs": "4.0.1",
    "puppeteer-core": "25.16.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "undici": "7.30.1",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.40.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/javascript": "1.5.6",
    "@mcp-b/global": "5.0.1",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@phosphor-icons/react": "2.1.10",
    "@sentry/react": "11.16.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.25",
    "@types/node": "22.19.1",
    "@types/pg": "^8.11.11",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "cn": "0.2.4",
    "dockview-react": "8.3.1",
    "drizzle-kit": "^0.30.6",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "mediabunny": "1.45.3",
    "postcss": "8.5.32",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "zustand": "5.0.11"
  }
}
